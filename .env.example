# ── Database (Postgres) ──────────────────────────────
POSTGRES_USER=ugpilot
POSTGRES_PASSWORD=ugpilot
POSTGRES_DB=ugpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ugpilot:ugpilot@localhost:5432/ugpilot

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=debug

# ── Mail (AES for IMAP/SMTP passwords at rest) ───────
MAIL_SECRET=change-me-to-a-long-random-string

# ── SearXNG (docker compose; app uses SEARXNG_URL) ───
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://127.0.0.1:8080/
SEARXNG_SECRET=change-me-to-a-long-random-string

# ── Storage ──────────────────────────────────────────
# local = filesystem (dev). r2 = Cloudflare R2 (prod).
STORAGE_DRIVER=local
STORAGE_PATH=./.storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# ── Media ────────────────────────────────────────────
MEDIA_MAX_TEXT_CHARS=14000
TELEGRAM_MAX_MEDIA_BYTES=20971520

# ── Telegram Bot ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_HISTORY_LIMIT=40
TELEGRAM_MAX_TOOL_ROUNDS=3
