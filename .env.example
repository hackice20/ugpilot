# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Database (Postgres) ──────────────────────────────
POSTGRES_USER=ugpilot
POSTGRES_PASSWORD=ugpilot
POSTGRES_DB=ugpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ugpilot:ugpilot@localhost:5432/ugpilot

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── AI Providers ─────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=debug

# ── Mail (encrypt IMAP/SMTP app passwords at rest) ──
# Prefer a dedicated secret; falls back to JWT_SECRET if unset.
MAIL_SECRET=change-me-to-a-long-random-string

# ── SearXNG (private metasearch; localhost only on Oracle ARM) ──
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://127.0.0.1:8080/
SEARXNG_SECRET=change-me-to-a-long-random-string

# ── Storage ──────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./.storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Media (Telegram attachments) ─────────────────────
VISION_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
MEDIA_MAX_TEXT_CHARS=14000
TELEGRAM_MAX_MEDIA_BYTES=20971520

# ── Telegram Bot ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_HISTORY_LIMIT=40
TELEGRAM_MAX_TOOL_ROUNDS=3

# ── Discord Bot ──────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ── Ports ────────────────────────────────────────────
WEB_PORT=3000
API_PORT=3001
NGINX_PORT=80
